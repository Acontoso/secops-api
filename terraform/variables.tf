variable "account_id" {
  description = "Expected deployment account; provider guard generated by Terragrunt."
  type        = string
  validation {
    condition     = can(regex("^[0-9]{12}$", var.account_id)) && var.account_id != "000000000000"
    error_message = "Set the real 12-digit account ID for this environment."
  }
}

variable "aws_region" {
  description = "Deployment region."
  type        = string
  default     = "ap-southeast-2"
}

variable "environment" {
  description = "Environment identifier, independent of module internals."
  type        = string
  validation {
    condition     = contains(["dev", "prod"], var.environment)
    error_message = "This composition supports dev or prod; modules are environment-independent."
  }
}

variable "project" {
  description = "Short resource-name prefix."
  type        = string
  default     = "soar-api"
}

variable "tags" {
  description = "Organization-specific ownership, billing and repository tags."
  type        = map(string)
  default     = {}
}

variable "ecr_repository_url" {
  description = "Existing ECR repository in the deployment account/region. Terraform does not manage it."
  type        = string
}

variable "image_uri" {
  description = "Single-platform Lambda image in this account/region, pinned by digest."
  type        = string
}

variable "ssm_kms_key_arn" {
  description = "External CMK encrypting the SSM SecureStrings; values are never read by Terraform."
  type        = string
}

variable "application_kms_key_arn" {
  description = "External CMK encrypting the base64 ciphertext inside SSM values; may equal the SSM key."
  type        = string
}

variable "identity_pool_id" {
  description = "External Azure-integrated Cognito Identity Pool ID."
  type        = string
}

variable "identity_pool_login" {
  description = "External developer-identity login identifier; not an OAuth credential."
  type        = string
  validation {
    condition     = length(trimspace(var.identity_pool_login)) > 0
    error_message = "Supply the identity login identifier for the external integration."
  }
}

variable "integration_environment" {
  description = "Nonsecret application integration settings (tenant/client/list identifiers). Never put tokens or credentials here."
  type        = map(string)
  default     = {}
  validation {
    condition = alltrue([for key in keys(var.integration_environment) : contains([
      "TENANT_ID", "TENANT_ID_MA", "WESHEALTH_GRAPH_AZ_CLIENT_ID", "WESHEALTH_MA_GRAPH_AZ_CLIENT_ID",
      "WH_LIST_ID", "MA_LIST_ID", "LISTNAME"
    ], key)])
    error_message = "Only the documented nonsecret integration setting names are supported."
  }
}

variable "memory_size" {
  description = "Lambda memory in MiB."
  type        = number
  default     = 512
}

variable "reserved_concurrent_executions" {
  description = "Concurrency cap; -1 uses the unreserved pool."
  type        = number
  default     = 10
}

variable "log_retention_days" {
  description = "CloudWatch application/API log retention."
  type        = number
  default     = 30
}

variable "deletion_protection_enabled" {
  description = "Protect data tables against accidental deletion."
  type        = bool
  default     = true
}

variable "notification_subscriptions" {
  description = "Optional explicit SNS subscriptions; email endpoints require confirmation."
  type = map(object({
    protocol = string
    endpoint = string
  }))
  default = {}
}

variable "api_rate_limit" {
  description = "Actual stage-level steady-state request rate."
  type        = number
  default     = 20
}

variable "api_burst_limit" {
  description = "Actual stage-level burst request limit."
  type        = number
  default     = 40
}

variable "api_cloudwatch_role_arn" {
  description = "Existing API Gateway account logging role if already centrally managed; null creates the singleton account setting."
  type        = string
  default     = null
}

variable "openapi_schema" {
  description = "OpenAPI YAML or JSON supplied by the caller; the deployed API URL replaces its servers list."
  type        = string
  default     = "{\"openapi\":\"3.0.0\",\"info\":{\"title\":\"API\",\"version\":\"1.0.0\"},\"paths\":{}}"
  validation {
    condition     = can(yamldecode(var.openapi_schema).openapi) && can(yamldecode(var.openapi_schema).paths)
    error_message = "Supply a valid OpenAPI document."
  }
}

variable "agentcore" {
  description = "Optional external OAuth integration. Leave null until the API and external outbound provider exist."
  type = object({
    discovery_url      = string
    audiences          = list(string)
    oauth_provider_arn = string
    oauth_secret_arn   = string
  })
  default = null
}
